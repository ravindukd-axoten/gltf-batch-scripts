{
  "$schema": "../schemas/streaming_policy.schema.json",
  "_comment": "WP-0313 PROPOSAL (numbers measured on device later; Open World Streaming Research gaps 1-3, 6). Floor loads one cell at a time and activates one per frame inside a 2 ms main-thread budget; background loading priority 2 ms on Floor and Low (gap 3). cell_size_m is the world grid (128 m, AGENTS.md). Look-ahead and layer bias order the load queue: near layer first, cells ahead of the focus first.",
  "schema_version": 1,
  "id": "streaming_policy",
  "status": "proposal",
  "cell_size_m": 128,
  "look_ahead_s": 2.0,
  "far_layer_bias_m": 256,
  "starve_frames": 90,
  "activation_cost_default_ms": 3.0,
  "activation_cost_ema_alpha": 0.3,
  "hitch": {
    "threshold_ms": 33.4,
    "ring_size": 32
  },
  "tiers": {
    "floor": {
      "max_concurrent_loads": 1,
      "activate_budget_ms": 2.0,
      "max_activations_per_frame": 1,
      "background_loading_priority_ms": 2,
      "unloads_per_frame": 1
    },
    "low": {
      "max_concurrent_loads": 1,
      "activate_budget_ms": 2.5,
      "max_activations_per_frame": 1,
      "background_loading_priority_ms": 2,
      "unloads_per_frame": 1
    },
    "mid": {
      "max_concurrent_loads": 2,
      "activate_budget_ms": 3.0,
      "max_activations_per_frame": 2,
      "background_loading_priority_ms": 4,
      "unloads_per_frame": 2
    },
    "high": {
      "max_concurrent_loads": 2,
      "activate_budget_ms": 4.0,
      "max_activations_per_frame": 3,
      "background_loading_priority_ms": 4,
      "unloads_per_frame": 2
    },
    "ultra": {
      "max_concurrent_loads": 3,
      "activate_budget_ms": 5.0,
      "max_activations_per_frame": 4,
      "background_loading_priority_ms": 4,
      "unloads_per_frame": 3
    }
  }
}
