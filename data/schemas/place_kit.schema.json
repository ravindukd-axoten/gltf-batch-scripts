{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "place_kit.schema.json",
 "title": "Place kit piece: a drive-in or drive-through kit, or a shared site part, with its site anchors (P207 E2, plan 'Enterable and drive-in places')",
 "description": "One file per kit piece in data/places/. Geometry is built in Blender by tools/city/build_places_kit.py from `dims`; the anchors are the data Unity's PlaceSite (P207 E5) reads and are also exported as glTF empties with the same names. Frame: piece-local, Unity axes after import (x right along the front, y up, z forward: into the bay or along the direction of travel), metres, pivot on the ground. Site parts (kind site_part: price pylons, shop, pavers, cones; P207 fuel kit) are placed next to a canopy by the site and may have no anchors. Fuel operators (palette + mark) live in data/places/fuel_operators.json (own schema).",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "id", "kind", "status", "placeholder", "description", "glb", "dims", "footprint_m",
              "budget_low", "materials", "serves", "anchors", "refs"],
 "properties": {
  "$schema": {"type": "string"},
  "schema_version": {"const": 1},
  "id": {"type": "string", "pattern": "^(KIT|PROP|DEC)_[A-Za-z]+(_[A-Za-z]+)*_[A-Z]$"},
  "kind": {"enum": ["drive_in_bay", "drive_through", "site_part", "service_lift", "wash_tunnel", "handwash_bay"]},
  "site_type": {"enum": ["garage", "car_wash", "tuk_works", "shared"], "description": "Which separate business site the piece belongs to (agent 2026-11-21: garage, wash and service centres are separate businesses in empty spaces, never one court)."},
  "rules": {"type": "object", "additionalProperties": false, "description": "Agent rules for service sites, read by the site and the server.",
   "properties": {"placement": {"const": "standalone_lot"}, "timed_jobs": {"type": "boolean"}, "own_garage_instant": {"type": "boolean"}, "pay_to_skip": {"const": false},
                  "fee": {"enum": ["free"]}, "tips_on_clean": {"type": "boolean"}, "bikes_hand_wash_only": {"type": "boolean"}}},
  "status": {"enum": ["proposed", "approved"]},
  "placeholder": {"type": "boolean"},
  "placeholder_note": {"type": "string"},
  "description": {"type": "string"},
  "operator": {"type": "string", "pattern": "^[a-z]+$", "description": "Key in data/places/fuel_operators.json (fuel kit) or data/places/service_operators.json (service kit)."},
  "params": {"type": "object", "additionalProperties": false, "description": "Fuel canopy module parameters (citylib/fuel_kit.canopy).",
   "properties": {"plan": {"enum": ["rect", "L"]}, "fascia": {"enum": ["flat", "curved", "purlin"]},
                  "column": {"enum": ["square_banded", "slim_round", "angled"]}, "columns_on": {"enum": ["islands", "grid"]},
                  "hood": {"enum": ["none", "box", "angled"]},
                  "walls": {"enum": ["back", "end", "back_end"]}, "colour": {"enum": ["red", "operator"]},
                  "banner_cell": {"$ref": "#/$defs/pt2"}, "arch_at": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number"}},
                  "slat_cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pt2"}},
                  "floor": {"enum": ["none", "dry", "wet"], "description": "Service shed / tunnel floor slab state: wet = puddles, tyre tracks, drain channel (COLOR_0; High may add a wet smoothness)."},
                  "module": {"type": "string", "pattern": "^KIT_[A-Za-z0-9]+(_[A-Za-z0-9]+)*$", "description": "Overlay piece (fascia sign): the module whose origin it shares."},
                  "lift_rows": {"type": "integer", "minimum": 1, "maximum": 2, "description": "Truss shed: bay rows under one roof (2 = rows facing a middle aisle, photos 5, 6)."},
                  "soffit": {"enum": ["panel", "line", "round"]}}},
  "glb": {"type": "string", "pattern": "^unity/BatchIsland/Assets/BatchIsland/Art/World/Kit/(KIT|PROP|DEC)_[A-Za-z]+(_[A-Za-z]+)*_[A-Z]\\.glb$"},
  "dims": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": -50, "maximum": 50}},
  "footprint_m": {"type": "object", "additionalProperties": false, "required": ["x", "z", "height"],
   "properties": {"x": {"$ref": "#/$defs/range"}, "z": {"$ref": "#/$defs/range"},
                  "height": {"type": "number", "minimum": 0.05, "maximum": 12}}},
  "budget_low": {"type": "object", "additionalProperties": false, "required": ["tris_lod0", "draws"],
   "properties": {"tris_lod0": {"type": "integer", "minimum": 50, "maximum": 60000},
                  "draws": {"type": "integer", "minimum": 1, "maximum": 8},
                  "tris_lod1": {"type": "integer", "minimum": 50, "maximum": 60000, "description": "Cap for the <id>_LOD1 node in the same glb (LOD0 minus the detail() parts)."}}},
  "materials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MAT_"}},
  "serves": {"type": "array", "minItems": 0, "uniqueItems": true,
   "items": {"enum": ["bike", "scooter", "tuk", "car", "van"]}},
  "station_id": {"type": "string", "pattern": "^STN_"},
  "anchors": {"type": "array", "minItems": 0, "items": {"$ref": "#/$defs/anchor"}},
  "refs": {"type": "array", "items": {"type": "string"}},
  "note": {"type": "string"}
 },
 "$defs": {
  "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
  "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
  "pt2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
  "anchor": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "pos"],
   "properties": {
    "name": {"type": "string", "pattern": "^(CAM|POSE|KERB|TRIGGER|STOP|LANE|QUEUE|SIGN|BAY|MECH|WASH|HW|TOOLS|SEAT|LIGHT|NPC|FX|SLOT)_[A-Za-z0-9_]+$"},
    "kind": {"enum": ["camera", "vehicle_pose", "kerb_stop", "trigger_box", "pump_stop", "lane", "queue_slot", "queue_lane", "sign_slot",
                      "service_bay", "mechanic_stand", "wash_path", "wash_gate", "handwash_bay", "tool_rack", "seat", "light", "npc_spot", "fx_emitter", "prop_slot"]},
    "pos": {"$ref": "#/$defs/vec3"},
    "yaw_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "look_at": {"$ref": "#/$defs/vec3"},
    "fov_deg": {"type": "number", "minimum": 20, "maximum": 90},
    "size": {"$ref": "#/$defs/vec3"},
    "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/pt2"}},
    "width_m": {"type": "number", "minimum": 1, "maximum": 6},
    "stop_kmh": {"type": "number", "minimum": 0, "maximum": 10},
    "for": {"type": "string"},
    "slot_spacing_m": {"type": "object", "additionalProperties": false, "required": ["bike", "tuk", "car"],
     "description": "queue_lane: metres of chain one queued vehicle uses (body + gap), per kind.",
     "properties": {"bike": {"type": "number", "minimum": 1, "maximum": 12}, "tuk": {"type": "number", "minimum": 1, "maximum": 12},
                    "car": {"type": "number", "minimum": 1, "maximum": 12}}},
    "max_slots": {"type": "integer", "minimum": 1, "maximum": 60, "description": "queue_lane: tuk slots on the chain inside the piece."},
    "feeds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^STOP_"}, "description": "queue_lane: pump stops the head vehicle is sent to."},
    "overflow": {"enum": ["none", "road_kerb"], "description": "queue_lane: what the spawner does past the tail."},
    "size_class": {"enum": ["S", "M", "L"], "description": "service_bay / handwash_bay: largest vehicle class (S bike or scooter, M tuk or small car, L car or van)."},
    "serves": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["bike", "scooter", "tuk", "car", "van"]}},
    "lift": {"enum": ["two_post", "single_post_inground", "scissor", "none"]},
    "drive": {"enum": ["through_north", "through_south", "drive_in", "reverse_in"]},
    "role": {"enum": ["lift_operator", "bay_mechanic", "wash_attendant", "attendant", "idle", "queue_driver"], "description": "mechanic_stand / npc_spot: who stands here (NPC pass)."},
    "speed_mps": {"type": "number", "minimum": 0.1, "maximum": 3, "description": "wash_path: conveyor speed."},
    "spacing_m": {"type": "number", "minimum": 2, "maximum": 12, "description": "wash_path: gap between vehicles on the line."},
    "programmes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^WASH_[A-Za-z]+$"}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["at_m", "arch", "fx"],
     "properties": {"at_m": {"type": "number", "minimum": 0, "maximum": 40}, "arch": {"enum": ["pre_soak", "foam", "brushes", "rinse", "dryer"]}, "fx": {"type": "string"}}}},
    "tools": {"type": "array", "minItems": 1, "items": {"enum": ["hose", "foam_lance", "bucket_mitt", "chamois"]}},
    "min_seconds": {"type": "object", "additionalProperties": false, "required": ["S", "M", "L"],
     "properties": {"S": {"type": "number", "minimum": 5, "maximum": 300}, "M": {"type": "number", "minimum": 5, "maximum": 300}, "L": {"type": "number", "minimum": 5, "maximum": 300}}},
    "fee": {"enum": ["free"], "description": "handwash_bay: hand wash costs the player nothing; a clean vehicle earns tips (tips_on_clean)."},
    "tips_on_clean": {"type": "boolean"},
    "timed_job": {"type": "boolean", "description": "service_bay: a service job takes real time (server timer); no pay-to-skip."},
    "own_garage_instant": {"type": "boolean", "description": "service_bay: the same bay at the player's own garage does the job instantly."},
    "light": {"type": "object", "additionalProperties": false, "required": ["type", "color", "lumen", "range_m", "tiers"],
     "description": "light: a realtime light Medium/High may spawn (Low keeps the pool baked into COLOR_0, no realtime light). Points straight down.",
     "properties": {"type": {"enum": ["spot", "point"]}, "color": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
                    "lumen": {"type": "number", "minimum": 100, "maximum": 20000}, "range_m": {"type": "number", "minimum": 1, "maximum": 30},
                    "spot_deg": {"type": "number", "minimum": 10, "maximum": 170},
                    "tiers": {"type": "array", "minItems": 1, "items": {"enum": ["Low", "Medium", "High"]}}}},
    "effect": {"enum": ["spray", "foam", "mist", "air"], "description": "fx_emitter: particle effect the site spawns here (High: particles; Low: a cheap card or none)."},
    "note": {"type": "string"}
   }}
 }
}
